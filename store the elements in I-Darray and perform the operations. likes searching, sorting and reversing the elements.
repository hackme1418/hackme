#include <stdio.h>

int main() {
    int arr[50], n, i, j, key, temp, found = 0;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter %d elements: ", n);
    for(i=0; i<n; i++)
        scanf("%d", &arr[i]);

    // Display original array
    printf("Original Array: ");
    for(i=0; i<n; i++)
        printf("%d ", arr[i]);
    printf("\n");

    // Searching
    printf("Enter element to search: ");
    scanf("%d", &key);
    for(i=0; i<n; i++){
        if(arr[i] == key){
            printf("Element %d found at position %d\n", key, i+1);
            found = 1;
            break;
        }
    }
    if(!found)
        printf("Element %d not found\n", key);

    // Sorting (Bubble Sort)
    for(i=0; i<n-1; i++){
        for(j=0; j<n-i-1; j++){
            if(arr[j] > arr[j+1]){
                temp = arr[j];
                arr[j] = arr[j+1];
                arr[j+1] = temp;
            }
        }
    }
    printf("Sorted Array: ");
    for(i=0; i<n; i++)
        printf("%d ", arr[i]);
    printf("\n");

    // Reversing
    printf("Reversed Array: ");
    for(i=n-1; i>=0; i--)
        printf("%d ", arr[i]);
    printf("\n");

    return 0;
}
